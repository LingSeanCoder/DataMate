# Copy file này thành .env rồi điền key thật.
# Lấy key tại: https://build.nvidia.com/nim (API Catalog)

NIM_API_KEY=nvapi_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model dùng để sinh SQL (tương thích OpenAI API qua NVIDIA NIM)
# Bài nộp phải chạy offline bằng Qwen2.5-Coder-14B-Instruct (luật: <=15B tham số, không gọi API).
# NIM_MODEL=

# Model dự phòng: tự chuyển sang khi model chính lỗi/trả nội dung rỗng.
# (Bỏ trống nếu không muốn dùng.)
# NIM_FALLBACK_MODEL=meta/llama-3.1-8b-instruct

# Local LLM (llama.cpp server trên Colab): đặt LOCAL_LLM_BASE_URL để bỏ qua NIM.
# LOCAL_LLM_BASE_URL=http://localhost:8000/v1
# LOCAL_LLM_MODEL=local
# LOCAL_LLM_API_KEY=local
# LOCAL_LLM_FALLBACK_MODEL=

# Ngân sách input-token ước lượng cho mỗi câu (NIM có rate limit cao hơn Groq).
# Tăng lên 12000+ nếu dùng tier trả phí.
DATAMATE_PROMPT_BUDGET=6300

# 1 = nhồi TOÀN BỘ rulebook vào prompt (cần tier trả phí).
DATAMATE_FULL_RULEBOOK=0
